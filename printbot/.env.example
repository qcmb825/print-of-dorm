# printbot 的配置模板。复制成同目录的 .env 再改（cp printbot/.env.example printbot/.env）。
# 系统环境变量优先于这份文件（与服务器同一套 setdefault 语义）。

# OneBot v11 正向 WebSocket 地址：LLBot / NapCat 在**本机**监听的端口。
# LLBot 在它的 WebUI（默认 127.0.0.1:3080）→ OneBot v11 → 新建一条
# 「正向 WS 服务」连接，端口填 8085，token 与下行一致。
ONEBOT_WS=ws://127.0.0.1:8085

# 与上面那条 WS 连接里配的 token 一致。两边都留空也可以（仅限本机回环）。
# ⚠️ **填错不会崩，但会一直连不上**：websocket-client 在握手阶段收到 401/403 时抛的
# 不是 OSError，所以 bot 那边专门兜了这一类（日志里会写「请检查 ONEBOT_ACCESS_TOKEN」，
# 然后按 1→60 秒退避重连）。看到那句就去 LLBot 的「正向 WS 服务」里核对一遍，
# 顺带确认端口与 ONEBOT_WS 一致。
ONEBOT_ACCESS_TOKEN=

# 打印服务器根地址。**生产必须改成站点地址（https://你的域名）**；
# 联调时指本机测试实例（http://127.0.0.1:8091）。
# 留在这个联调默认值上跑生产的样子是：启动自检连得上本机的旧实例、学生的单下到
# 一台谁都不知道的机器上 —— 所以改完域名第一件事是回来改这一行。
API_BASE=http://127.0.0.1:8091

# 站点地址：所有「去网页端操作」的引导文案都带上它，**包括未注册时发给学生的
# 注册链接**（写的是 `<SITE_URL>/login`，登录页里切「注册」页签 —— 没有独立的
# /register 路由）。必须是学生手机能打开的公网地址，别填 127.0.0.1。
# 默认 https://print.qcmb.cloud；联调/换域名时在这里改。结尾不要加斜杠（代码里会 rstrip）。
SITE_URL=https://print.qcmb.cloud

# bot 的全部身份：必须与服务器 .env 里的 BOT_TOKEN 一字不差。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
BOT_TOKEN=

# ---- QQ 文件下单的本地预校验（服务器同名常量的抄写，改一边记得改另一边）----
# 本地这道闸的价值是早拒：不合格的文件在国内就拦下，一个字节都不跨洋。
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# 「订单可取件」推送的轮询间隔（秒）。30 秒一天约 2880 个短请求，别再密了。
EVENTS_POLL_SECONDS=30

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# ---- 大模型兜底（可选）----
# 规则解析（nlu.py）认不出来的那句话才走这里 —— 它是锦上添花，不是主力：
# 日常说法（「黑白 2份」「第 1 份彩色」「都双面」）全部由规则处理，一次外网都不用发。
# 不配 key 就是关掉这一层，规则照常工作、功能不残缺。
# 任何 OpenAI 兼容的 /chat/completions 都能用（DeepSeek / 通义 / 智谱…）。
# key 是凭据：只写在这份 .env 里，不要提交进仓库。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 模型名要写成那家服务的真实 id（DeepSeek 是 deepseek-chat，通义是 qwen-plus 之类）。
LLM_MODEL=deepseek-chat
# 它是**对话中间**的一次调用，学生在等回话，所以超时给得短（秒）。
# 超时 / 连不上 / 返回的不是 JSON —— 一律当作「这句没听懂」，
# 绝不重试、绝不把对话卡在这里（学生会以为机器人死了）。
LLM_TIMEOUT=8

# ---- 批量下单（2026-09-28）----
# 一次最多收几份文件。**必须 ≤ 服务端的 BATCH_ORDER_MAX_FILES**（默认 10），
# 否则学生会在传完 20 份之后才收到一句「一次最多 10 份」。
BATCH_MAX_FILES=10
# 一批文件收到之后：隔多久追问、隔多久作废（秒，逗号分隔的多个时间点）。
# 时间从**最后一次活动**算起（新文件、新消息都会重新计时）；
# 追问里会把「按 A4 70g · 黑白 · 1 份 下单」整句念出来，学生回一个「好」就成单。
BATCH_REMIND_SECONDS=45,150
BATCH_TTL_SECONDS=300
# 份数上限（必须与服务端 config.COPIES_MAX 一致）。
# 学生说「彩色 80 份」时，printbot 会把它夹到这个数**并在回执里说明**，
# 而不是带着 80 去撞服务端的 400（那样他会一直回「好」，直到这一批作废）。
COPY_MAX=50
