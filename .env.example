# 宿舍打印服务 —— 配置示例
# 复制成 .env 后按需修改。.env 已被 .gitignore 忽略，不会进仓库。
# 已存在的系统环境变量优先于本文件，方便在服务器上直接覆盖。

# ---------- 基础 ----------
HOST=0.0.0.0
PORT=8080
# 生产环境必须保持 false！debug=true + 局域网可达 = Werkzeug 调试器任意代码执行
DEBUG=false
LOG_LEVEL=INFO
# waitress 工作线程数
THREADS=4

# ---------- 存储 ----------
# 文件保存目录。默认 C:/print/print_files/，权限不足时改到用户目录下
UPLOAD_FOLDER=C:/print/print_files/
DATABASE_PATH=print_service.db
# 单文件上传上限（MB）
MAX_UPLOAD_MB=50
# 允许的扩展名白名单
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# ---------- 管理口令 ----------
# 留空则不校验（仅限纯内网自用）。配置后订单列表/改状态/取文件都需要它
ADMIN_TOKEN=

# ---------- 计价 ----------
# 单位一律是「分/面」（面 = 一页纸的一面）。加 _CENTS 后缀是为了让单位不可能被搞错。
# 按「面」计价：单/双面公式统一。想按「张」报价，把双面单价设成「每张价 ÷ 2」
# （整数分下需为偶数：0.16 可以，0.15 会落到 0.16）。
PRICE_BLACK_SINGLE_CENTS=10
PRICE_BLACK_DOUBLE_CENTS=8
PRICE_COLOR_SINGLE_CENTS=100
PRICE_COLOR_DOUBLE_CENTS=75
# 最低消费，0 = 不启用。店主不想为几毛钱跑一趟时可设 100（即 1 元）
MIN_CHARGE_CENTS=0
# 单笔最多份数
MAX_COPIES=50

# ---------- 取件码 ----------
# 默认 4 位——要能在电话里念清楚，不轻易改长。想更安全可设 6
PICKUP_CODE_LENGTH=4

# ---------- /my-orders 防枚举限流 ----------
# 同一 IP 在窗口内「查不到」的次数上限。查到就清零，所以正常学生几乎不会触发。
# 阈值放宽是因为宿舍楼整栋可能共用一个 NAT 出口 IP，卡太严会误伤真实学生。
MY_ORDERS_MAX_FAILS=20
MY_ORDERS_WINDOW_SECONDS=300

# ---------- 跨域（可选）----------
# 默认只允许同源。确需给小程序/其它域名调用时在此配置，逗号分隔
CORS_ORIGINS=
