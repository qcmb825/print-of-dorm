# 小猫娘打印服务 —— 配置示例
#
# 用法：cp .env.example .env 然后按需修改。
#
# 这个文件只是**模板**，本身不参与运行；程序读的是同目录下的 .env。
# 两者是各自独立的文件，不会互相同步，所以内容不一样是正常的：
#   - 本文件进仓库（.gitignore 里用 !.env.example 单独放行），不放任何真实值；
#   - .env 不进仓库，装的是你本机的真实配置。
#
# 缺项不会报错，会直接落到代码里的默认值。优先级：
#   系统环境变量  >  .env 文件  >  代码里的默认值
# 所以 .env 只写你想改的那些项就够了，不必把下面每一项都抄过去。
# 反过来说，变量名拼错也不会报错，只会静默地用默认值 —— 改了不生效时，
# 先看启动横幅打出来的实际生效值，那才是权威答案。
#
# 支持的写法：# 开头的注释行、空行、export KEY=VALUE、值两侧可加单/双引号。


# ============================ 密钥（务必配置） ============================
# 以下两项不配也能启动，但会有功能不可用，生产环境必须自己固定配好。

# 会话 Cookie 签名密钥。泄露出去别人就能伪造登录态，切勿外传。
# 留空则每次启动随机生成 —— 后果是**重启后所有人登录态失效**。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 密码的可逆加密密钥（Fernet），账号管理里要查看凭据时靠它解密。
# 必须是合法的 Fernet 密钥，否则凭据看不了（启动会打 error 日志，但不阻断服务）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWORD_ENC_KEY=


# ============================ 内置管理账号（首次启动引导） ============================
# 首次启动会自动建表，并按这里的配置创建一个内置的管理账号。
# 同昵称已存在则跳过（只把缺的学号补上），可以放心重复执行。

SUPER_ADMIN_NICKNAME=superadmin

# 至少 8 位。**首次启动必须填**：账号尚未创建又没有可用密码时，程序会直接拒绝启动。
# 以前缺失时是随机生成并写进启动日志，等于把管理员口令存进日志文件，已取消这种做法。
SUPER_ADMIN_PASSWORD=

# 内置管理账号的**登录学号**。首次启动必须填，理由和上面那条密码一样：
# 登录方式是「学号 + 密码」，一个没有学号的账号建出来就是登不进去的，
# 而它偏偏是唯一能把别人升成管理员的入口 —— 缺了它程序会直接拒绝启动。
# 从老版本升级上来的部署（账号已存在、但当年允许学号留空）会自动补上这个值，
# 不需要手工改库；但那一份 .env 里同样要配上这一项，否则下次重建账号时又缺。
SUPER_ADMIN_STUDENT_ID=

# 下面两项留空会存成空字符串。
# 注意：real_name 是 UNIQUE 约束 —— 同时建多个管理账号时，不能都留空。
SUPER_ADMIN_REALNAME=
SUPER_ADMIN_DORM=


# ============================ 运行 ============================

# 监听地址。0.0.0.0 表示所有网卡可达（局域网内其他机器能访问）
HOST=0.0.0.0
PORT=8080

# 生产环境必须保持 false。
# 开着的话 Werkzeug 调试器会暴露源码，并留下任意代码执行的口子。
DEBUG=false

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ==================== 数据目录 ====================
# 所有 SQLite 库文件（主库、学生名单库、迁移前自动生成的 .bak 备份）都放这里。
# 库文件单独收进一个目录而不是散在项目根：源码、前端产物和运行数据混在一起时，
# 根本分不出哪些能删、「整目录替换前端产物」时特别容易误伤。
DATA_DIR=data

# 主数据库路径。留空则用 DATA_DIR/print_service.db，一般不用单独配
DATABASE_PATH=data/print_service.db

# 学生身份名单库（学号 -> 姓名）：注册时按学号查它校验身份。
# ⚠️ 里面是几万人的真实姓名 + 学号，属于他人个人信息：
#    不要提交进仓库，换机器 / 重新部署时要人工拷过去。
ROSTER_DB_PATH=data/roster.db

# 上传文件保存目录。目录不存在会自动创建。
# 建议指到独立的数据盘：里面是学生上传的打印件，体积长得比代码快得多。
# 相对路径的解析规则和 DATABASE_PATH 一致（按 app.py 所在目录，而不是启动目录）。
UPLOAD_FOLDER=data/uploads

# 单文件大小上限（MB）
MAX_UPLOAD_MB=50

# 允许上传的扩展名白名单，逗号分隔
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# 反代部署时设为 true，才会信任 X-Forwarded-For 里的真实客户端 IP。
# 直接暴露在公网时必须保持 false —— 否则客户端可以伪造 IP 绕过限流。
TRUST_PROXY=false

# 跨域白名单，逗号分隔。留空 = 只允许同源（推荐）。
# 确实要给小程序或其它域名调用时才配，例如：https://foo.com,https://bar.com
CORS_ORIGINS=


# ============================ 界面 ============================
# 仓库里有两套前端，共用同一套 /api 接口：
#   classic —— templates/index.html，单文件 Jinja 模板（经典樱花主题）
#   vue     —— static/app/，新版 Vue 3 界面
# 这里决定「默认」给哪一套：
#   random  —— 每个浏览器会话随机挑一套。掷完就记进 pod-ui Cookie，会话内保持稳定，
#              不会点一下换一套；关掉浏览器再打开才会重新掷。
#   classic / vue —— 全局定死一套
# 写错的值不报错、会静默回落到 random，所以拼错时看启动横幅打出来的实际值。
#
# ⚠️ 目前这一项**不生效**：app.py 里的 UI_SWITCH_ENABLED = False 把界面锁死在新版了，
#    连 URL 参数 /?ui=classic 也一起静默失效（不报错、不记日志）。
#    想临时切回经典版：把那个开关改成 True 再重启。
UI_MODE=vue


# ============================ 启动自检 ============================
# 端口绑定失败时的自动重试。端口被拒多半是本机代理 / VPN / 加速器类软件临时占用，
# 过几秒会自己恢复，所以默认重试 3 次、每次间隔 3 秒，而不是直接报错退出。

START_MAX_ATTEMPTS=3
START_RETRY_SECONDS=3


# ============================ 会话与登录 ============================

# 登录态有效期（天）
SESSION_DAYS=7

# 接入 HTTPS 后应设为 true，让浏览器只在加密连接上发送会话 Cookie。
# HTTP 环境下保持 false，否则登录会失效。
SESSION_COOKIE_SECURE=false

# 连续登录失败多少次锁定该 IP
LOGIN_MAX_FAILS=5

# 锁定时长（秒）
LOGIN_LOCK_SECONDS=300


# ==================== 未接单邮件提醒 ====================
# 新单下进来是「待计费 + 没人接」，得有人把它接走才算开工。
# 超过 CLAIM_ALERT_MINUTES 分钟还没人碰过的单，会给管理员发一封邮件。
#
# 这个功能的开关就是「有没有配 SMTP_HOST」——
# 不配就自动不启用（启动日志里会写一句原因），不用再单独去关。
# 提醒出任何问题都不会影响下单和接单：跑在独立线程里，异常只记日志。

# 总开关。想临时停掉提醒又不想删 SMTP 配置时用得上
CLAIM_ALERT_ENABLED=true

# 超过几分钟没人接就提醒。默认 3 分钟
CLAIM_ALERT_MINUTES=3

# 扫描间隔（秒）。默认 60
CLAIM_ALERT_INTERVAL=60

# 只提醒「最近多少小时内」下的单，默认 24。
# 给重启兜底：服务停几天再起来时，库里所有老单都满足「没人接 + 超过 3 分钟」，
# 没这道闸就会一口气炸出几十封早就没人关心的邮件。
CLAIM_ALERT_MAX_AGE_HOURS=24

# 发信失败后的退避秒数，默认 300。
# SMTP 密码填错 / 网络不通时，每 60 秒重试一次只会把日志刷满。
CLAIM_ALERT_RETRY_BACKOFF=300

# 一封邮件里最多列几笔单，默认 20，多的折成「另有 N 笔」。
CLAIM_ALERT_MAX_ITEMS=20


# ---- SMTP 发信服务器 ----
# 留空 SMTP_HOST = 不启用这个功能。填了才会真的发信。
SMTP_HOST=

# QQ 邮箱 / 163 邮箱都是 465（SSL）；Gmail 是 587（STARTTLS）
SMTP_PORT=465

# 加密方式：ssl（465）/ starttls（587）/ none（只在内网调试时用）
SMTP_SECURITY=ssl

# 登录用的邮箱地址，例如 12345678@qq.com
SMTP_USER=

# ⚠️ 这里填的是**授权码，不是邮箱密码**。
#    QQ 邮箱：设置 -> 账户 -> 开启 SMTP 服务 -> 生成授权码（16 位）。
#    授权码等价于密码，只放在本文件里，别提交、别外传、别贴给任何人。
SMTP_PASSWORD=

# 发件人地址。留空就用 SMTP_USER（绝大多数服务商要求两者一致）
MAIL_FROM=

# 收件人看到的发件人名称
MAIL_FROM_NAME=小猫娘打印服务

# 连接超时（秒），默认 15
SMTP_TIMEOUT=15

# 额外收件人，逗号分隔，可留空。
# 其它管理员的收件地址是**自动**从账号联系方式推出来的：
#   联系方式填了邮箱  -> 直接用
#   联系方式填了 QQ 号 -> QQ号@qq.com
#   填微信 / 没填      -> 跳过（微信推不出邮箱）
# 所以这里只需要补「自动推不出来」的那一个 —— 也就是内置管理账号
# （它由 .env 创建，压根没有联系方式字段）。
ALERT_MAIL_TO=

# ⚠️ 服务器的网络位置会影响送达：
#    QQ / 163 的 SMTP 对**海外 IP** 经常直接超时或拒连，而这类失败在日志里
#    只是一句连接超时，看起来和「对方服务器挂了」没有区别。
#    如果部署在境外，请先手工验证一次（临时把 CLAIM_ALERT_MINUTES 改成 1、
#    下一单、看日志里有没有「未接单提醒已发出」），
#    或者干脆换一台在境内的机器 / 换成别的发信服务。


# ==================== 取件邮件提醒 ====================
# 管理员把订单改成「可取了」的那一刻，给学生发一封邮件：
# 标题里带取件码，正文写取件地点、金额，并附上**接单人**的微信收款码。
#
# 和「未接单提醒」一样，这个功能的开关就是「有没有配 SMTP_HOST」——
# 不配就整条停掉（启动日志里写一句原因），不用再单独去关。
# 出任何问题都不影响改状态：改状态立刻返回，发信是后台线程补的。

# 总开关。想临时停掉又不想删 SMTP 配置时用得上
PICKUP_NOTIFY_ENABLED=true

# 扫描间隔（秒），默认 30。
# 比未接单提醒的 60 短：那边是催人干活，晚一分钟没人在意；
# 这边学生可能已经站在楼下了，差一分钟就得多站一分钟。
PICKUP_NOTIFY_INTERVAL=30

# 只提醒「最近多少小时内」变成可取件的单，默认 24。
# 同样是给重启兜底：服务停一天再起来，库里那批早就被取走的单
# 也满足「可取了 + 还没提醒过」，没这道闸就是一口气几十封过时邮件。
PICKUP_NOTIFY_MAX_AGE_HOURS=24

# 发信失败后的退避秒数，默认 300（同 CLAIM_ALERT_RETRY_BACKOFF 的道理）
PICKUP_NOTIFY_RETRY_BACKOFF=300

# 取件地点，原样写进邮件正文。写成人能看懂的一句话
PICKUP_ADDRESS=2号北201


# ============== 管理员收款码（取件邮件里附的那张图） ==============
# 每个管理员一张：谁接的单，邮件里就附谁的码 —— 钱进接单那个人的账。
# 上传入口在界面上（右上角账号菜单 -> 我的收款码），不用手工往磁盘丢文件。
# 数据库里存的**只是文件名**，文件本体在 PAY_QR_FOLDER 下。

# 存放目录。留空 = <DATA_DIR>/pay_qr
PAY_QR_FOLDER=

# 单张收款码的大小上限（字节），默认 2MB。
# 代码里另有一道 64KB 的下限：微信导出的收款码常常只有几十 KB，
# 手滑配成 1024 会让所有人都传不上去，所以配得比 64KB 还小时按 64KB 算。
PAY_QR_MAX_BYTES=2097152

# 兜底图：接单的管理员还没上传过自己的收款码时，邮件里附这一张。
# 留空 = <PAY_QR_FOLDER>/default.png。
# ⚠️ 它**不会**退回到超管的码：钱的去向必须是确定的，
#    宁可邮件里不附图（正文会改成「请到取件点向管理员付款」），
#    也不能把学生导到另一个人的收款码上。
PAY_QR_FALLBACK_IMAGE=


# ======================= QQ 机器人（LLOneBot） =======================

# bot 是**独立进程**，跑在境内那台机器上（QQ 客户端 + LLOneBot 必须在一起，
# 后端留在美国）。它没有浏览器会话，所以不走 session + CSRF，改用这个令牌：
#     Authorization: Bearer <BOT_TOKEN>
#
# 留空 = /api/bot/* 整组返回 503（不是「不校验」）。
#
# 生成一个随机值：
#     python -c "import secrets;print(secrets.token_urlsafe(32))"
# ⚠️ 它等价于 bot 的身份，只放在两处：后端的 .env、境内那台机器的 printbot 配置。
#    别粘进聊天记录、别提交到仓库。
BOT_TOKEN=


# ============================ 日志 ============================

# 日志目录与文件名
LOG_DIR=logs
LOG_FILE=app.log

# 单文件大小上限（字节，默认 5MB）与保留的备份个数
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10

# 是否同时输出到控制台 / 是否记录访问日志
LOG_CONSOLE=true
LOG_ACCESS=true
