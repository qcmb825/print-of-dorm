# 宿舍自助打印平台 —— 配置示例
#
# 用法：cp .env.example .env 然后按需修改。
# 注意：已经存在的**系统环境变量优先于本文件**，方便在服务器上覆盖而不动文件。
#
# 支持的写法：# 开头的注释行、空行、export KEY=VALUE、值两侧可加单/双引号。


# ============================ 密钥（务必配置） ============================
# 以下两项不配也能启动，但会有功能不可用，生产环境必须自己固定配好。

# 会话 Cookie 签名密钥。泄露出去别人就能伪造登录态，切勿外传。
# 留空则每次启动随机生成 —— 后果是**重启后所有人登录态失效**。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 密码的可逆加密密钥（Fernet），供超级管理员在后台查看明文密码。
# 必须是合法的 Fernet 密钥，否则超管看不了明文（启动会打 error 日志，但不阻断服务）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWORD_ENC_KEY=


# ============================ 超级管理员（首次启动引导） ============================
# 首次启动会自动建表，并按这里的配置创建一个超级管理员账号。
# 同昵称已存在则跳过，可以放心重复执行。

SUPER_ADMIN_NICKNAME=superadmin

# 不足 8 位（或留空）系统会随机生成一个，并**打印到启动日志**里，请从日志中取用。
SUPER_ADMIN_PASSWORD=

# 下面三项留空会存成空字符串。
# 注意：real_name 和 student_id 都是 UNIQUE 约束 —— 如果有多个超管，不能同时留空。
SUPER_ADMIN_REALNAME=
SUPER_ADMIN_STUDENT_ID=
SUPER_ADMIN_DORM=


# ============================ 运行 ============================

# 监听地址。0.0.0.0 表示所有网卡可达（局域网内其他机器能访问）
HOST=0.0.0.0
PORT=8080

# 生产环境必须保持 false。
# 开着的话 Werkzeug 调试器会暴露源码，并留下任意代码执行的口子。
DEBUG=false

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 数据库路径。相对路径以 app.py 所在目录为基准。
# 开发时建议指向项目内，避免污染默认位置：./print_service.db
DATABASE_PATH=print_service.db

# 上传文件保存目录。目录不存在会自动创建。
# 默认值写死了 Windows 盘符，换平台必须改。开发时建议：./print_files
UPLOAD_FOLDER=C:/print/print_files/

# 单文件大小上限（MB）
MAX_UPLOAD_MB=50

# 允许上传的扩展名白名单，逗号分隔
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx

# 反代部署时设为 true，才会信任 X-Forwarded-For 里的真实客户端 IP。
# 直接暴露在公网时必须保持 false —— 否则客户端可以伪造 IP 绕过限流。
TRUST_PROXY=false

# 跨域白名单，逗号分隔。留空 = 只允许同源（推荐）。
# 确实要给小程序或其它域名调用时才配，例如：https://foo.com,https://bar.com
CORS_ORIGINS=


# ============================ 启动自检 ============================
# 端口绑定失败时的自动重试。端口被拒多半是本机代理 / VPN / 加速器类软件临时占用，
# 过几秒会自己恢复，所以默认重试 3 次、每次间隔 3 秒，而不是直接报错退出。

START_MAX_ATTEMPTS=3
START_RETRY_SECONDS=3


# ============================ 会话与登录 ============================

# 登录态有效期（天）
SESSION_DAYS=7

# 接入 HTTPS 后应设为 true，让浏览器只在加密连接上发送会话 Cookie。
# HTTP 环境下保持 false，否则登录会失效。
SESSION_COOKIE_SECURE=false

# 连续登录失败多少次锁定该 IP
LOGIN_MAX_FAILS=5

# 锁定时长（秒）
LOGIN_LOCK_SECONDS=300


# ============================ 日志 ============================

# 日志目录与文件名
LOG_DIR=logs
LOG_FILE=app.log

# 单文件大小上限（字节，默认 5MB）与保留的备份个数
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10

# 是否同时输出到控制台 / 是否记录访问日志
LOG_CONSOLE=true
LOG_ACCESS=true
